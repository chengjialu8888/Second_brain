.DS_Store
__pycache__/
*.pyc

# Local image generation drafts.
assets/github-header*.png
!assets/github-header2.png

# Obsidian local state. Keep shared vault config, templates, graph colors, and snippets tracked.
.obsidian/workspace*.json
.obsidian/cache/
.obsidian/plugins/
.obsidian/themes/
.obsidian/community-plugins.json
brain/.obsidian/

# Local/private generated source snapshots can be sensitive.
brain/sources/calendar/*.json
brain/sources/calendar/*.txt
brain/sources/chats/*
brain/sources/feishu-docs/*
brain/sources/web/*
!brain/sources/chats/.gitkeep
!brain/sources/feishu-docs/.gitkeep
!brain/sources/web/.gitkeep
!brain/sources/calendar/.gitkeep

# Local/private active workspaces can include retrieved strategic context.
brain/workspace/current.md
brain/workspace/sessions/*.md
